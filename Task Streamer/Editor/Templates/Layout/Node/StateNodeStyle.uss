.node {
    min-width: 150px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

#node-state {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    display: flex;
}

#node-border {
    background-color: rgb(50, 50, 50);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

#title-label {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    align-self: stretch;
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 14px;
    height: auto;
    position: relative;
    -unity-font-style: bold;
    transform-origin: center;
    color: rgb(194, 194, 194);
}

#selection-border {
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    position: absolute;
    left: 0;
    top: 11px;
    right: 0;
    bottom: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(255, 128, 0);
    border-right-color: rgb(255, 128, 0);
    border-top-color: rgb(255, 128, 0);
    border-bottom-color: rgb(255, 128, 0);
    overflow: hidden;
    visibility: visible;
    display: flex;
    flex-wrap: nowrap;
}

:selected > #selection-border {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    overflow: visible;
}

#divider {
    height: 10px;
}

#input > .port {
    background-color: rgb(48, 48, 48);
    width: 100%;
    height: 100%;
    cursor: url("project://database/Assets/TaskStreamer/Task%20Streamer/Resource/Touch.png?fileID=2800000&guid=b3e981dcf6204ee40a74cea955848a81&type=3#Touch");
}

#output > .port {
    min-width: auto;
    background-color: rgb(48, 48, 48);
    align-self: center;
    align-items: auto;
    flex-wrap: wrap-reverse;
    justify-content: flex-end;
    flex-grow: 0;
    visibility: visible;
    position: relative;
    bottom: 0;
    background-image: none;
    width: 100%;
    height: 100%;
    cursor: url("project://database/Assets/TaskStreamer/Task%20Streamer/Resource/Touch.png?fileID=2800000&guid=b3e981dcf6204ee40a74cea955848a81&type=3#Touch");
    padding-top: 6px;
    padding-bottom: 6px;
}

#input > .port > #connector {
    align-self: center;
    display: flex;
    visibility: hidden;
    position: absolute;
    justify-content: center;
    align-content: auto;
    align-items: center;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

#output > .port > #connector {
    align-self: center;
    display: flex;
    visibility: hidden;
    flex-wrap: nowrap;
    left: auto;
    right: auto;
    position: absolute;
    flex-grow: 1;
}

.state-node-Any {
    background-color: rgb(52, 161, 147);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-repeat: no-repeat no-repeat;
}

.state-node-Enter {
    background-color: rgb(34, 197, 73);
}

.state-node-Exit {
    background-color: rgb(207, 34, 34);
}

.state-node-Action {
    background-color: rgb(128, 128, 128);
}

.state-node-SubGraph {
    background-color: rgb(255, 126, 0);
}
