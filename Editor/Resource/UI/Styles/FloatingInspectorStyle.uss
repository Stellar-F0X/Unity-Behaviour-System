.title-bar {
    height: 25px;
    background-color: rgb(38, 38, 38);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
}

.title-label {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.content-container {
    flex-grow: 1;
    margin-top: 5px;
    margin-bottom: 8px;
    margin-left: 5px;
    margin-right: 5px;
}
