#header-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

#variable-foldout > Toggle {
    position: absolute;
    top: -20px;
    margin-top: 3px;
    margin-bottom: 3px;
    margin-left: 4px;
    scale: 1.35 1.35;
    transform-origin: center;
}

#variable-foldout > #unity-content {
    flex-grow: 1;
    flex-direction: column;
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 5px;
    margin-bottom: 0;
}

#blackboard-property-view > #variable-foldout > .unity-foldout__toggle > .unity-foldout__input > #unity-checkmark {
    margin-right: 0;
    margin-top: 1px;
    background-color: rgb(47, 47, 47);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(36, 36, 36);
    border-left-color: rgb(36, 36, 36);
    border-right-color: rgb(36, 36, 36);
    border-top-color: rgba(255, 255, 255, 0);
}
