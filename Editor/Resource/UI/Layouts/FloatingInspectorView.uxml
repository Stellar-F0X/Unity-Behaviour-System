<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/TaskStreamer/Editor/Resource/UI/Styles/FloatingInspectorStyle.uss?fileID=7433441132597879392&amp;guid=46e98dfba409ed8468e07d91a0ee906e&amp;type=3#FloatingInspectorStyle" />
    <TaskStreamer.Tool.FloatingInspectorView style="background-color: rgb(57, 57, 57); min-width: 270px; max-width: 500px; flex-grow: 0; min-height: 100px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(132, 132, 132); border-right-color: rgb(132, 132, 132); border-top-color: rgb(132, 132, 132); border-bottom-color: rgb(132, 132, 132); max-height: 500px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; width: 270px;">
        <ui:VisualElement name="title-bar" class="title-bar" style="flex-grow: 0; background-color: rgb(43, 43, 43);">
            <ui:Label text="Inspector" name="title-label" class="title-label" style="-unity-text-align: middle-left;" />
        </ui:VisualElement>
        <ui:ScrollView name="content-container" class="content-container" />
        <ui:VisualElement name="resizer" style="flex-grow: 1; position: absolute; right: 0; bottom: 0; width: 20px; height: 20px; background-image: url(&quot;project://database/Packages/com.unity.timeline/Editor/StyleSheets/Images/Icons/TimelineClipFG.png?fileID=2800000&amp;guid=33b1871a2d09cfa459a93f4e8feb5c41&amp;type=3#TimelineClipFG&quot;);" />
    </TaskStreamer.Tool.FloatingInspectorView>
</ui:UXML>
