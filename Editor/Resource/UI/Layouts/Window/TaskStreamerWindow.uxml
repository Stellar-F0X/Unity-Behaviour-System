<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/TaskStreamer/Editor/Resource/UI/Layouts/Window/TaskStreamerWindowStyle.uss?fileID=7433441132597879392&amp;guid=9f7ef0b4ed1e21f4580d6f651abac776&amp;type=3#TaskStreamerWindowStyle" />
    <TaskStreamer.Tool.SplitView fixed-pane-initial-dimension="250">
        <ui:VisualElement name="left-panel" style="flex-grow: 1; flex-direction: column; width: 250px; flex-shrink: 1; min-width: 0; display: flex; min-height: auto; max-width: none; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(25, 25, 25); border-right-color: rgb(25, 25, 25); border-top-color: rgb(25, 25, 25); border-bottom-color: rgb(25, 25, 25); visibility: visible; overflow: visible; flex-wrap: nowrap;">
            <TaskStreamer.Tool.SplitView orientation="Vertical" fixed-pane-initial-dimension="300" name="sub-splitView" style="flex-direction: column; background-color: rgb(61, 61, 61);">
                <ui:VisualElement name="inspector" style="flex-grow: 1; flex-shrink: 1; min-height: 20px;">
                    <ui:Label tabindex="-1" text=" Inspector" parse-escape-sequences="true" display-tooltip-when-elided="true" name="left-view-label" picking-mode="Ignore" class="window-label" style="flex-shrink: 1; flex-grow: 0; height: 20px; align-items: center; -unity-text-align: middle-left;" />
                    <ui:ScrollView horizontal-scroller-visibility="Hidden" style="flex-grow: 1;">
                        <TaskStreamer.Tool.EditorInspectorView style="margin-top: 5px; margin-bottom: 0; margin-right: 2px; margin-left: 2px; height: auto; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0;" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="blackboard" style="flex-grow: 1; flex-shrink: 1; background-color: rgb(61, 61, 61); top: auto; height: auto; min-height: 34px; position: relative; overflow: hidden;">
                    <ui:VisualElement name="blackboard-toolbar" style="flex-grow: 0; flex-direction: row; min-width: auto; background-color: rgb(42, 42, 42); min-height: 14px;">
                        <ui:Label tabindex="-1" text=" Blackboard" parse-escape-sequences="true" display-tooltip-when-elided="true" name="left-view-label" class="window-label" style="flex-grow: 1; -unity-text-align: middle-left; height: 20px;" />
                        <ui:Button name="element-add-button" style="background-image: url(&quot;project://database/Packages/com.unity.render-pipelines.core/Editor/LookDev/Icons/d_Add@2x.png?fileID=2800000&amp;guid=daa49a1f06460a04b9827dd6f0bace08&amp;type=3#d_Add@2x&quot;); background-color: rgba(60, 60, 60, 0); -unity-background-image-tint-color: rgb(255, 255, 255); padding-left: 9px; padding-right: 9px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0;" />
                    </ui:VisualElement>
                    <uie:ObjectField allow-scene-objects="true" name="blackboard-field" type="TaskStreamer.BlackboardAsset, TaskStreamer" tooltip="Blackboard Asset" enabled="true" picking-mode="Ignore" style="margin-top: 2px; margin-bottom: 2px; -unity-font-style: bold; min-height: 0; flex-shrink: 1; flex-direction: row; align-items: auto; flex-grow: 0; flex-wrap: wrap;" />
                    <TaskStreamer.Tool.BlackboardView fixed-item-height="50" selection-type="None" horizontal-scrolling="false" show-foldout-header="false" show-add-remove-footer="false" allow-remove="false" allow-add="false" reorder-mode="Animated" reorderable="true" show-border="false" show-alternating-row-backgrounds="ContentOnly" language-direction="Inherit" binding-source-selection-mode="Manual" virtualization-method="DynamicHeight" show-bound-collection-size="true" item-template="project://database/Assets/TaskStreamer/Editor/Resource/UI/Layouts/Blackboard/BBVariableItem.uxml?fileID=9197481963319205126&amp;guid=c8a586cd667247c419ff74d87f2587b8&amp;type=3#BBVariableItem" name="blackboard-Property-ListView" style="flex-grow: 1; min-height: 0; flex-shrink: 1; flex-basis: auto; max-height: 100%; background-color: rgba(0, 0, 0, 0.18); position: relative; overflow: visible; display: flex; visibility: visible; opacity: 1; flex-direction: column;" />
                </ui:VisualElement>
            </TaskStreamer.Tool.SplitView>
        </ui:VisualElement>
        <ui:VisualElement name="right-panel" style="flex-grow: 1; flex-shrink: 1; min-width: 10%; max-width: none; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-left: 0;">
            <uie:Toolbar name="right-toolbar" style="justify-content: flex-start; height: 20px; min-height: auto; flex-shrink: 1; max-height: none; flex-grow: 0; align-items: center; align-content: auto; border-top-width: 1px; border-right-width: 0; border-bottom-width: 1px; border-left-width: 0; flex-wrap: nowrap; align-self: auto; min-width: 0; flex-basis: auto; flex-direction: row;">
                <TaskStreamer.Tool.GraphBreadcrumbs style="flex-grow: 1; min-height: 95%; min-width: 0; align-items: stretch;" />
                <uie:ToolbarToggle label="Minimap" name="active-minimap" value="false" style="overflow: visible; flex-shrink: 1; align-self: flex-start; justify-content: flex-start; align-items: auto;" />
            </uie:Toolbar>
            <TaskStreamer.Tool.TaskGraphView focusable="true" style="flex-grow: 1;">
                <TaskStreamer.Tool.MiniMapView view-data-key="6df03c20-78ec-4a7a-9f20-9d56dcdb0292" enabled="true" style="left: auto; right: auto; top: auto; bottom: auto; flex-grow: 0; min-width: initial; min-height: initial; background-color: rgba(30, 30, 30, 0.78); position: relative; width: 220px; height: 200px; align-items: auto; flex-wrap: wrap; border-left-color: rgb(222, 222, 222); border-right-color: rgb(222, 222, 222); border-top-color: rgb(222, 222, 222); border-bottom-color: rgb(222, 222, 222); visibility: hidden;" />
            </TaskStreamer.Tool.TaskGraphView>
        </ui:VisualElement>
    </TaskStreamer.Tool.SplitView>
</ui:UXML>
