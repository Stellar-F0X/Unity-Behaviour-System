<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/TaskStreamer/Editor/Resource/UI/Layouts/Blackboard/BBVariableItemStyle.uss?fileID=7433441132597879392&amp;guid=64c8fb2f8709a824cb398043c8843094&amp;type=3#BBVariableItemStyle" />
    <engine:VisualElement name="blackboard-property-view" style="flex-grow: 0; flex-direction: column; margin-top: 4px; margin-bottom: 4px; padding-top: 0; padding-bottom: 0; margin-right: 0; margin-left: 0; padding-left: 0;">
        <engine:VisualElement name="header-container" style="flex-grow: 1; margin-left: 20px; flex-direction: row; flex-wrap: nowrap; align-items: flex-end; justify-content: flex-start; align-self: auto; align-content: auto;">
            <engine:TextField placeholder-text="Key ID" name="name-field" vertical-scroller-visibility="AlwaysVisible" hide-placeholder-on-focus="false" multiline="false" style="flex-shrink: 1; min-width: auto; flex-direction: column; flex-grow: 1; margin-right: 4px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-left: 4px; max-width: none; flex-wrap: nowrap; overflow: hidden; align-content: flex-start; align-self: auto; justify-content: flex-start; align-items: stretch; width: auto; height: 18px; min-height: initial; max-height: initial; margin-bottom: 0; margin-top: 0; padding-right: 0;" />
            <engine:Button icon-image="project://database/Assets/TaskStreamer/Editor/Resource/UI/Images/Delete.png?fileID=2800000&amp;guid=8091cef9245c02446876c26c51e446e9&amp;type=3#Delete" name="delete-button" style="background-color: rgb(47, 47, 47); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; padding-left: 3px; padding-right: 3px; flex-direction: row-reverse; margin-left: 3px; margin-right: 3px; min-width: auto; min-height: initial; flex-shrink: 0; height: 18px; width: 18px; max-height: initial; max-width: none; margin-bottom: 0; margin-top: 0; border-top-color: rgba(48, 48, 48, 0); border-right-color: rgb(36, 36, 36); border-left-color: rgb(36, 36, 36); border-right-width: 0; border-left-width: 0; border-top-width: 0;" />
        </engine:VisualElement>
        <engine:Foldout value="false" toggle-on-label-click="false" name="variable-foldout" style="flex-direction: row; margin-top: 0; margin-bottom: 0; margin-right: 0; margin-left: 0;">
            <engine:VisualElement name="value-container" style="flex-grow: 1; flex-direction: row; margin-top: 3px; margin-bottom: 7px;">
                <engine:Label text="Label" name="type-name-label" picking-mode="Ignore" style="margin-right: 5px; -unity-text-align: middle-left;" />
                <engine:IMGUIContainer name="imgui-field" focusable="false" language-direction="LTR" style="flex-grow: 1; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; margin-left: 0; margin-right: 0; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-top-width: 0; border-bottom-width: 0; margin-top: 0; min-height: auto; margin-bottom: 0; min-width: auto; flex-direction: row; max-width: none; flex-wrap: nowrap; flex-shrink: 1; width: auto;" />
            </engine:VisualElement>
        </engine:Foldout>
    </engine:VisualElement>
</engine:UXML>
