<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="../../Styles/PanelStyle.uss" />
    <ui:VisualElement name="container">
        <ui:ListView allow-add="false" allow-remove="false" show-bound-collection-size="false" virtualization-method="DynamicHeight" name="service-list" selection-type="None" focusable="true" />
    </ui:VisualElement>
    <ui:Button text="Add Service" name="add-button" style="width: 200px; align-self: center; margin-top: 5px; margin-bottom: 5px;" />
</ui:UXML>
