<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/TaskStreamer/Editor/Resource/Styles/ConditionFieldListStyle.uss?fileID=7433441132597879392&amp;guid=e8ef7230983a9ba4992d000d44ed0b1c&amp;type=3#ConditionFieldListStyle" />
    <ui:EnumField label="Evaluation Policy" value="Center" type="TaskStreamer.EvaluationPolicy, TaskStreamer" name="condition-evaluation-policy" include-obsolete-values="false" style="padding-left: 2px; padding-right: 1px; margin-right: 1px; margin-left: 1px;" />
    <ui:VisualElement name="list-container" style="flex-grow: 1; margin-left: 1px; margin-right: 1px; padding-left: 1px; padding-right: 1px; margin-top: 1px; margin-bottom: 1px; padding-top: 1px; padding-bottom: 1px;">
        <ui:ListView show-foldout-header="true" header-title="Conditions" allow-add="false" allow-remove="false" show-bound-collection-size="false" show-border="false" item-template="project://database/Assets/TaskStreamer/Editor/Resource/Layouts/Inspector/ConditionField.uxml?fileID=9197481963319205126&amp;guid=8f6749f2ba031714ab7d92b52a286630&amp;type=3#ConditionField" show-add-remove-footer="false" reorder-mode="Simple" name="condition-list-view" selection-type="Single" binding-source-selection-mode="Manual" reorderable="false" show-alternating-row-backgrounds="ContentOnly" style="flex-grow: 0; min-height: 0;" />
        <ui:Button name="condition-add-btn" style="flex-grow: 0; flex-shrink: 1; position: absolute; height: 18px; border-bottom-width: 1px; right: 1px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 37px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; top: 2px;" />
    </ui:VisualElement>
</ui:UXML>
