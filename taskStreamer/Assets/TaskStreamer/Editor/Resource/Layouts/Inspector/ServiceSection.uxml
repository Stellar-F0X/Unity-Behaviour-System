<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="../../Styles/PanelStyle.uss" />
    <ui:VisualElement name="container" picking-mode="Ignore" style="flex-grow: 0; flex-direction: column;">
        <ui:Foldout text="Foldout" name="main-header">
            <ui:ListView name="field-list" virtualization-method="DynamicHeight" allow-add="false" allow-remove="false" show-alternating-row-backgrounds="None" show-border="false" selection-type="None" show-bound-collection-size="false" focusable="true" picking-mode="Ignore" />
        </ui:Foldout>
        <ui:Toggle name="enable-toggle" value="true" style="position: absolute; top: 4px; left: auto; height: 14px; right: auto;" />
        <ui:Button name="delete-button" style="position: absolute; top: 4px; left: auto; height: 15px; width: 45px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; right: 0; border-top-width: 1px; border-left-color: rgb(45, 45, 45); border-right-color: rgb(45, 45, 45); border-top-color: rgb(45, 45, 45); border-bottom-color: rgb(45, 45, 45); border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; margin-right: 2px; margin-left: 2px;" />
        <ui:VisualElement name="header-line" class="line" style="margin-top: 1px;" />
    </ui:VisualElement>
</ui:UXML>
