.blackboard > .mainContainer > #content > #header {
    background-color: rgb(43, 43, 43);
    align-self: auto;
    flex-direction: row;
    height: 18px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.blackboard > .mainContainer > #content > #header > #addButton {
    margin-top: 0;
    padding-bottom: 3px;
    padding-top: 0;
    margin-bottom: 0;
    padding-right: 2px;
    margin-right: 0;
    transform-origin: center;
    padding-left: 3px;
    margin-left: 2px;
}

.blackboard > .mainContainer > #content > #header > #labelContainer > #subTitleLabel {
    display: none;
    visibility: hidden;
}

.blackboard > .mainContainer > #content > #header > #labelContainer > #titleLabel {
    -unity-text-align: middle-left;
    font-size: 12px;
    -unity-font-style: normal;
}

.blackboard {
    background-color: rgb(57, 57, 57);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(44, 44, 44);
    border-right-color: rgb(44, 44, 44);
    border-top-color: rgb(44, 44, 44);
    border-bottom-color: rgb(44, 44, 44);
}

.blackboard > .blackboardField > .mainContainer {
    height: 30px;
}