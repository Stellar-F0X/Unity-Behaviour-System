<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/TaskStreamer/Editor/Resource/UI/Styles/FloatingInspectorStyle.uss?fileID=7433441132597879392&amp;guid=46e98dfba409ed8468e07d91a0ee906e&amp;type=3#FloatingInspectorStyle" />
    <TaskStreamer.Tool.FloatingInspectorView style="background-color: rgb(57, 57, 57); min-width: 250px; max-width: none; flex-grow: 0; min-height: 70px; border-top-width: 0; border-right-width: 0; border-bottom-width: 1px; border-left-width: 0; border-left-color: rgb(43, 43, 43); border-right-color: rgb(43, 43, 43); border-top-color: rgb(43, 43, 43); border-bottom-color: rgb(43, 43, 43); max-height: none; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; width: 270px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 10px; padding-left: 0; top: auto;">
        <ui:VisualElement name="title-bar" class="title-bar" style="flex-grow: 0; background-color: rgb(43, 43, 43); margin-left: 0; margin-right: 0; padding-top: 0; padding-right: 0; padding-bottom: 1px; padding-left: 0; margin-bottom: 1px; margin-top: 0; border-bottom-width: 1px; border-bottom-left-radius: 1px; border-bottom-right-radius: 1px; border-left-color: rgb(20, 20, 20); border-right-color: rgb(20, 20, 20); border-top-color: rgb(20, 20, 20); border-bottom-color: rgb(20, 20, 20); width: 100%; border-top-left-radius: 5px; border-top-right-radius: 5px;">
            <ui:Label text="Inspector" name="title-label" class="title-label" style="-unity-text-align: middle-left; margin-left: 5px; margin-right: 5px; color: rgb(238, 238, 238);" />
        </ui:VisualElement>
        <ui:ScrollView name="content-container" class="content-container" style="padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px;" />
        <ui:VisualElement name="resizer" style="flex-grow: 1; position: absolute; right: 0; bottom: 0; width: 20px; height: 20px; background-image: none; -unity-background-image-tint-color: rgb(150, 150, 150);" />
    </TaskStreamer.Tool.FloatingInspectorView>
</ui:UXML>
