.node {
    min-width: 150px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

#node-state {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    display: flex;
}

#node-border {
    background-color: rgb(50, 50, 50);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

#title-label {
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 0;
    margin-left: 5px;
    align-self: stretch;
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 15px;
    height: auto;
    position: relative;
    -unity-font-style: bold;
    transform-origin: center;
    color: rgb(194, 194, 194);
    text-shadow: 0 5px 0 rgb(0, 0, 0);
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 4px;
    padding-top: 4px;
    min-width: 120px;
}

#selection-border {
    margin-top: 2px;
    margin-right: 2px;
    margin-bottom: 2px;
    margin-left: 2px;
    position: absolute;
    left: 0;
    top: 11px;
    right: 0;
    bottom: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-left-color: rgb(255, 128, 0);
    border-right-color: rgb(255, 128, 0);
    border-top-color: rgb(255, 128, 0);
    border-bottom-color: rgb(255, 128, 0);
    overflow: hidden;
    visibility: visible;
    display: flex;
    flex-wrap: nowrap;
}

#type-label {
    align-self: center;
    align-content: auto;
    margin-top: 2px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-bottom: 2px;
    padding-left: 3px;
    padding-right: 3px;
    margin-left: 7px;
    margin-right: 7px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(150, 150, 150);
    border-right-color: rgb(150, 150, 150);
    border-top-color: rgb(150, 150, 150);
    border-bottom-color: rgb(150, 150, 150);
    font-size: 10px;
    color: rgb(170, 170, 170);
    background-color: rgb(45, 45, 45);
    -unity-text-align: middle-center;
}

:selected > #selection-border {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    overflow: visible;
}

#divider {
    height: 10px;
}

.state-node > #input > .port {
    background-color: rgb(30, 30, 30);
    width: 100%;
    height: 100%;
    cursor: url("project://database/Assets/TaskStreamer/Editor/Resource/UI/Images/Touch.png?fileID=2800000&guid=b3e981dcf6204ee40a74cea955848a81&type=3#Touch");
}

.state-node > #output > .port {
    min-width: auto;
    background-color: rgb(30, 30, 30);
    align-self: center;
    align-items: auto;
    flex-wrap: wrap-reverse;
    justify-content: flex-end;
    flex-grow: 0;
    visibility: visible;
    position: relative;
    bottom: 0;
    background-image: none;
    width: 100%;
    height: 100%;
    cursor: url("project://database/Assets/TaskStreamer/Editor/Resource/UI/Images/Touch.png?fileID=2800000&guid=b3e981dcf6204ee40a74cea955848a81&type=3#Touch");
    padding-top: 6px;
    padding-bottom: 6px;
}

.state-node > #input > .port > #connector {
    align-self: center;
    display: flex;
    visibility: hidden;
    position: absolute;
    justify-content: center;
    align-content: auto;
    align-items: center;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.state-node > #output > .port > #connector {
    align-self: center;
    display: flex;
    visibility: hidden;
    flex-wrap: nowrap;
    left: auto;
    right: auto;
    position: absolute;
    flex-grow: 1;
}

.behavior-node > #input > .port {
    min-width: 60%;
    background-color: rgb(25, 25, 25);
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    align-self: center;
    align-items: auto;
    flex-wrap: nowrap;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(70, 70, 70);
    border-right-color: rgb(70, 70, 70);
    border-top-color: rgb(70, 70, 70);
    border-bottom-color: rgb(70, 70, 70);
    cursor: url("project://database/Assets/TaskStreamer/Editor/Resource/UI/Images/Touch.png?fileID=2800000&guid=b3e981dcf6204ee40a74cea955848a81&type=3#Touch");
}

.behavior-node > #output > .port {
    min-width: 60%;
    background-color: rgb(25, 25, 25);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    align-self: center;
    align-items: auto;
    flex-wrap: wrap-reverse;
    justify-content: flex-end;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgb(70, 70, 70);
    border-right-color: rgb(70, 70, 70);
    border-top-color: rgb(70, 70, 70);
    border-bottom-color: rgb(70, 70, 70);
    cursor: url("project://database/Assets/TaskStreamer/Editor/Resource/UI/Images/Touch.png?fileID=2800000&guid=b3e981dcf6204ee40a74cea955848a81&type=3#Touch");
}

.behavior-node > #input > .port > #connector {
    align-self: center;
    display: flex;
    visibility: hidden;
    flex-wrap: nowrap;
    position: absolute;
}

.behavior-node > #output > .port > #connector {
    align-self: center;
    display: flex;
    visibility: hidden;
    flex-wrap: nowrap;
    left: auto;
    right: auto;
    position: absolute;
}
